# Fish Tracker App Environment Variables

# OpenWeather API Key (required for weather features)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Session secret (optional - a default is provided in docker-compose.yml)
# SESSION_SECRET=your_custom_session_secret_here

# Client (Vite) — Google Drive backup UI (Settings → Backup)
# OAuth 2.0 Web Client ID; enable Google Drive API + drive.file scope on the consent screen.
# VITE_GOOGLE_CLIENT_ID=

# Browser API key for Google Picker (“Restore from Google Drive”). Restrict by HTTP referrer.
# Enable “Google Picker API” in the same Google Cloud project.
# VITE_GOOGLE_API_KEY=

# Set to "true" only when server-side Google OAuth routes (/api/auth/google) are implemented.
# GOOGLE_OAUTH_ENABLED=false